# Aplicacion
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4321

# PostgreSQL local. Dale usa 5433 en el host para evitar conflictos con instalaciones locales de PostgreSQL.
# PostgreSQL sigue escuchando en 5432 dentro del contenedor.
POSTGRES_DB=dale
POSTGRES_USER=dale_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433
DATABASE_URL=postgresql://dale_app:CHANGE_ME@127.0.0.1:5433/dale?schema=public

# Se usara cuando se implemente autenticacion.
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
