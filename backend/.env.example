# Aplicacion
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4321

# PostgreSQL local. Reemplazar CHANGE_ME solo en backend/.env local.
POSTGRES_DB=dale
POSTGRES_USER=dale_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dale_app:CHANGE_ME@localhost:5432/dale?schema=public

# Se usara cuando se implemente autenticacion.
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
