---
import AuthNav from "../components/vue/AuthNav.vue";
import AccessibilityControls from "../components/vue/AccessibilityControls.vue";
import "../styles/global.css";
import "../styles/responsive.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dale | Practica hablar con seguridad",
  description = "Practica conversaciones reales y mejora tu forma de comunicarte con métricas claras.",
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isProgress = pathname === "/progreso";
const isTraining = pathname === "/entrenar";
const isMap = pathname === "/mapa";
const isAccount = pathname === "/cuenta";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // Aplicar ajustes antes del primer renderizado para evitar parpadeo.
      (() => {
        try {
          const size = localStorage.getItem("dale-a11y-text-size");
          const contrast = localStorage.getItem("dale-a11y-contrast");
          document.documentElement.dataset.daleTextSize =
            size === "large" || size === "extra" ? size : "normal";
          document.documentElement.dataset.daleContrast = contrast === "high" ? "high" : "standard";
        } catch {
          document.documentElement.dataset.daleTextSize = "normal";
          document.documentElement.dataset.daleContrast = "standard";
        }
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#172554" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/png" href="/DaleConTodoMiKing.png" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#contenido-principal" class="skip-link">Saltar al contenido principal</a>

    <div class="dale-site-shell min-h-screen text-slate-800">
      <header class="dale-site-header sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur">
        <div class="dale-header-inner mx-auto flex min-h-16 max-w-7xl items-center justify-between gap-3 px-4 py-2 sm:px-6 lg:px-8">
          <a href="/" class="dale-brand flex min-w-0 items-center gap-3" aria-label="Ir al inicio de Dale">
            <img
              src="/DaleConTodoMiKing.png"
              alt="Dale"
              class="h-10 w-10 shrink-0 rounded-xl object-cover shadow-sm"
            />
            <div class="hidden leading-tight xs:block sm:block">
              <strong class="block text-lg font-black tracking-tight text-slate-950">Dale</strong>
              <span class="hidden text-xs text-slate-500 md:block">Practica. Mide. Mejora.</span>
            </div>
          </a>

          <nav aria-label="Navegación principal" class="dale-primary-nav flex min-w-0 items-center gap-1 sm:gap-2">
            <a
              href="/entrenar"
              aria-current={isTraining ? "page" : undefined}
              class:list={[
                "hidden rounded-lg px-3 py-2 text-sm font-semibold transition xl:inline-flex",
                isTraining ? "bg-slate-100 text-slate-950" : "text-slate-700 hover:bg-slate-100 hover:text-slate-950",
              ]}
            >
              Entrenar
            </a>
            <a
              href="/#escenarios"
              aria-current={isHome ? "page" : undefined}
              class:list={[
                "hidden rounded-lg px-3 py-2 text-sm font-semibold transition xl:inline-flex",
                isHome ? "bg-slate-100 text-slate-950" : "text-slate-700 hover:bg-slate-100 hover:text-slate-950",
              ]}
            >
              Escenarios
            </a>
            <a
              href="/progreso"
              aria-current={isProgress ? "page" : undefined}
              class:list={[
                "hidden rounded-lg px-3 py-2 text-sm font-semibold transition xl:inline-flex",
                isProgress ? "bg-slate-100 text-slate-950" : "text-slate-700 hover:bg-slate-100 hover:text-slate-950",
              ]}
            >
              Progreso
            </a>
            <a
              href="/mapa"
              aria-current={isMap ? "page" : undefined}
              class:list={[
                "hidden rounded-lg px-3 py-2 text-sm font-semibold transition xl:inline-flex",
                isMap ? "bg-slate-100 text-slate-950" : "text-slate-700 hover:bg-slate-100 hover:text-slate-950",
              ]}
            >
              Mapa
            </a>
            <a
              href="/cuenta"
              aria-current={isAccount ? "page" : undefined}
              class:list={[
                "hidden rounded-lg px-3 py-2 text-sm font-semibold transition xl:inline-flex",
                isAccount ? "bg-slate-100 text-slate-950" : "text-slate-700 hover:bg-slate-100 hover:text-slate-950",
              ]}
            >
              Mis prácticas
            </a>
            <details class="dale-mobile-menu relative xl:hidden">
              <summary class="flex min-h-11 cursor-pointer list-none items-center rounded-xl border border-slate-300 bg-white px-3 text-sm font-bold text-slate-900 focus-visible:outline focus-visible:outline-4 focus-visible:outline-blue-700">Menú</summary>
              <nav aria-label="Navegación móvil" class="dale-mobile-menu-panel absolute right-0 top-full z-50 mt-2 flex w-[min(18rem,calc(100vw-2rem))] flex-col gap-1 rounded-2xl border border-slate-200 bg-white p-3 shadow-2xl">
                <a href="/entrenar" class="rounded-lg px-4 py-3 font-bold text-slate-900 hover:bg-blue-50">Preparar entrenamiento</a>
                <a href="/#escenarios" class="rounded-lg px-4 py-3 font-bold text-slate-900 hover:bg-blue-50">Todos los escenarios</a>
                <a href="/progreso" class="rounded-lg px-4 py-3 font-bold text-slate-900 hover:bg-blue-50">Mi progreso</a>
                <a href="/mapa" class="rounded-lg px-4 py-3 font-bold text-slate-900 hover:bg-blue-50">Mapa</a>
                <a href="/cuenta" class="rounded-lg px-4 py-3 font-bold text-slate-900 hover:bg-blue-50">Mis prácticas</a>
              </nav>
            </details>
            <div class="dale-auth-slot"><AuthNav client:load /></div>
          </nav>
        </div>
      </header>

      <main id="contenido-principal" class="dale-main" tabindex="-1">
        <slot />
      </main>

      <footer class="dale-site-footer mt-16 border-t border-slate-200 bg-white">
        <div class="mx-auto flex max-w-7xl flex-col gap-5 px-4 py-8 text-sm text-slate-600 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
          <div>
            <p class="font-semibold text-slate-900">Dale</p>
            <p>Plataforma gratuita y abierta para practicar comunicación en situaciones reales.</p>
          </div>
          <nav aria-label="Ayuda y enlaces legales" class="flex flex-wrap gap-x-5 gap-y-2">
            <a href="/?guia=1" class="font-medium hover:text-slate-950">Guía inicial</a>
            <a href="/privacidad" class="font-medium hover:text-slate-950">Privacidad</a>
            <a href="/terminos" class="font-medium hover:text-slate-950">Términos</a>
            <a href="/cookies" class="font-medium hover:text-slate-950">Cookies</a>
          </nav>
        </div>
      </footer>
    </div>
    <AccessibilityControls client:load />
    <script is:inline>
      // Mantener sincronizado el menu cuando se redimensiona la ventana.
      (() => {
        const menu = document.querySelector("details.dale-mobile-menu");
        if (!(menu instanceof HTMLDetailsElement)) return;
        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape" || !menu.open) return;
          event.preventDefault();
          menu.open = false;
          menu.querySelector("summary")?.focus();
        });
        document.addEventListener("pointerdown", (event) => {
          if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
            menu.open = false;
          }
        });
        const desktop = window.matchMedia("(min-width: 80rem)");
        desktop.addEventListener("change", (event) => {
          if (event.matches) menu.open = false;
        });
      })();
    </script>
  </body>
</html>
