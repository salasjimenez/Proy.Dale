---
import AuthNav from "../components/vue/AuthNav.vue";
import AccessibilityControls from "../components/vue/AccessibilityControls.vue";
import CreatorModal from "../components/vue/CreatorModal.vue";
import "../styles/global.css";
import "../styles/responsive.css";
import "../styles/charmy-v165.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dale | Practica hablar con seguridad",
  description = "Practica conversaciones reales y mejora tu forma de comunicarte con métricas claras.",
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isProgress = pathname === "/progreso";
const isTraining = pathname === "/entrenar";
const isMap = pathname === "/mapa";
const isAccount = pathname === "/cuenta";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // Aplicar ajustes antes del primer renderizado para evitar parpadeo.
      (() => {
        try {
          const size = localStorage.getItem("dale-a11y-text-size");
          const contrast = localStorage.getItem("dale-a11y-contrast");
          document.documentElement.dataset.daleTextSize =
            size === "large" || size === "extra" ? size : "normal";
          document.documentElement.dataset.daleContrast = contrast === "high" ? "high" : "standard";
        } catch {
          document.documentElement.dataset.daleTextSize = "normal";
          document.documentElement.dataset.daleContrast = "standard";
        }
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#172554" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/png" href="/charmy/charmy-icon.webp" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#contenido-principal" class="skip-link">Saltar al contenido principal</a>

    <div class="dale-site-shell min-h-screen text-slate-800">
      <header class="dale-site-header charmy-site-header sticky top-0 z-50">
        <div class="dale-header-inner charmy-header-inner mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <a href="/" class="charmy-site-brand" aria-label="Ir al inicio de Dale">
            <img src="/charmy/charmy-icon.webp" width="40" height="40" alt="" /> <span>Dale</span>
          </a>
          <nav class="charmy-header-links" aria-label="Navegación principal">
            <a href="/" aria-current={isHome ? "page" : undefined}>Inicio</a>
            <a href="/escenarios">Casos</a>
            <a href="/entrenar" aria-current={isTraining ? "page" : undefined}>Entrenar</a>
            <a href="/progreso" aria-current={isProgress ? "page" : undefined}>Resultados</a>
            <a href="/analisis-voz">Analítica de voz</a>
          </nav>
          <nav class="dale-primary-nav" aria-label="Accesos de usuario">
            <a class="charmy-nav-demo" href="/probar">Probar gratis</a>
            <details class="dale-mobile-menu relative xl:hidden">
              <summary aria-label="Abrir navegación móvil">☰ Menú</summary>
              <nav aria-label="Navegación móvil" class="dale-mobile-menu-panel">
                <a href="/probar">Probar con Charmy</a>
                <a href="/escenarios">Elegir caso</a>
                <a href="/entrenar">Preparar entrenamiento</a>
                <a href="/progreso">Mi progreso</a>
                <a href="/analisis-voz">Analítica de voz</a>
                <a href="/mapa" aria-current={isMap ? "page" : undefined}>Mapa</a>
                <a href="/cuenta" aria-current={isAccount ? "page" : undefined}>Mis prácticas</a>
                <a href="/login">Iniciar sesión</a>
                <a href="/registro">Crear cuenta</a>
              </nav>
            </details>
            <div class="dale-auth-slot"><AuthNav client:load /></div>
          </nav>
        </div>
      </header>

      <div id="dale-api-status" role="status" aria-live="polite" class="hidden border-b border-amber-300 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-950">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3">
          <span>Dale no puede contactar al servidor. Las prácticas podrían no guardarse. Reintenta cuando vuelva la conexión.</span>
          <button id="dale-api-dismiss" type="button" class="rounded-lg border border-amber-800 px-3 py-2">Cerrar aviso</button>
        </div>
      </div>

      <main id="contenido-principal" class="dale-main" tabindex="-1">
        <slot />
      </main>

      <footer class="dale-site-footer charmy-footer">
        <div class="charmy-footer-inner">
          <div class="charmy-footer-brand"><strong>Dale</strong><p>Entrena conversaciones reales con Charmy. Una introducción gratuita antes de crear una cuenta.</p></div>
          <nav class="charmy-footer-links" aria-label="Ayuda y enlaces legales">
            <a href="/probar">Guía inicial</a>
            <a href="/privacidad">Privacidad</a>
            <a href="/terminos">Términos</a>
            <a href="/cookies">Cookies</a>
            <a href="/analisis-voz">Analítica de voz</a>
            <CreatorModal client:load />
          </nav>
        </div>
      </footer>
    </div>
    <AccessibilityControls client:load />
    <script is:inline>
      // Mantener sincronizado el menu cuando se redimensiona la ventana.
      (() => {
        const menu = document.querySelector("details.dale-mobile-menu");
        if (!(menu instanceof HTMLDetailsElement)) return;
        document.addEventListener("keydown", (event) => {
          if (event.key !== "Escape" || !menu.open) return;
          event.preventDefault();
          menu.open = false;
          menu.querySelector("summary")?.focus();
        });
        document.addEventListener("pointerdown", (event) => {
          if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
            menu.open = false;
          }
        });
        const desktop = window.matchMedia("(min-width: 80rem)");
        desktop.addEventListener("change", (event) => {
          if (event.matches) menu.open = false;
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const banner = document.getElementById("dale-api-status");
        const dismiss = document.getElementById("dale-api-dismiss");
        if (!banner) return;
        const show = () => banner.classList.remove("hidden");
        const hide = () => banner.classList.add("hidden");
        window.addEventListener("dale:api-unavailable", show);
        window.addEventListener("dale:api-available", hide);
        window.addEventListener("offline", show);
        window.addEventListener("online", hide);
        dismiss?.addEventListener("click", hide);
        if (!navigator.onLine) show();
      })();
    </script>
  </body>
</html>
