---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dale | Practica hablar con seguridad",
  description = "Practica conversaciones reales y mejora tu forma de comunicarte con métricas claras.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#172554" />
    <link rel="icon" type="image/png" href="/DaleConTodoMiKing.png" />
    <title>{title}</title>
  </head>
  <body>
    <div class="min-h-screen text-slate-800">
      <header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur">
        <div class="mx-auto flex min-h-16 max-w-7xl items-center justify-between gap-4 px-4 py-2 sm:px-6 lg:px-8">
          <a href="/" class="flex items-center gap-3" aria-label="Ir al inicio de Dale">
            <img
              src="/DaleConTodoMiKing.png"
              alt="Dale"
              class="h-10 w-10 rounded-xl object-cover shadow-sm"
            />
            <div class="leading-tight">
              <strong class="block text-lg font-black tracking-tight text-slate-950">Dale</strong>
              <span class="hidden text-xs text-slate-500 sm:block">Practica. Mide. Mejora.</span>
            </div>
          </a>

          <nav aria-label="Navegación principal" class="flex items-center gap-1 sm:gap-2">
            <a
              href="/#escenarios"
              class="rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 hover:text-slate-950"
            >
              Escenarios
            </a>
            <span
              class="hidden rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-500 sm:inline-flex"
              title="Se habilitará en una siguiente etapa"
            >
              Mi progreso · próximamente
            </span>
          </nav>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="mt-16 border-t border-slate-200 bg-white">
        <div class="mx-auto flex max-w-7xl flex-col gap-5 px-4 py-8 text-sm text-slate-600 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
          <div>
            <p class="font-semibold text-slate-900">Dale</p>
            <p>Plataforma gratuita y abierta para practicar comunicación en situaciones reales.</p>
          </div>
          <nav aria-label="Enlaces legales" class="flex flex-wrap gap-x-5 gap-y-2">
            <a href="/privacidad" class="font-medium hover:text-slate-950">Privacidad</a>
            <a href="/terminos" class="font-medium hover:text-slate-950">Términos</a>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>
