---
import AuthNav from "../components/vue/AuthNav.vue";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dale | Practica hablar con seguridad",
  description = "Practica conversaciones reales y mejora tu forma de comunicarte con métricas claras.",
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isProgress = pathname === "/progreso";
const isMap = pathname === "/mapa";
const isAccount = pathname === "/cuenta";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#172554" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/png" href="/DaleConTodoMiKing.png" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#contenido-principal" class="skip-link">Saltar al contenido principal</a>

    <div class="min-h-screen text-slate-800">
      <header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur">
        <div class="mx-auto flex min-h-16 max-w-7xl items-center justify-between gap-3 px-4 py-2 sm:px-6 lg:px-8">
          <a href="/" class="flex min-w-0 items-center gap-3" aria-label="Ir al inicio de Dale">
            <img
              src="/DaleConTodoMiKing.png"
              alt="Dale"
              class="h-10 w-10 shrink-0 rounded-xl object-cover shadow-sm"
            />
            <div class="hidden leading-tight xs:block sm:block">
              <strong class="block text-lg font-black tracking-tight text-slate-950">Dale</strong>
              <span class="hidden text-xs text-slate-500 md:block">Practica. Mide. Mejora.</span>
            </div>
          </a>

          <nav aria-label="Navegación principal" class="flex min-w-0 items-center gap-1 sm:gap-2">
            <a
              href="/#escenarios"
              aria-current={isHome ? "page" : undefined}
              class:list={[
                "hidden rounded-lg px-3 py-2 text-sm font-semibold transition md:inline-flex",
                isHome ? "bg-slate-100 text-slate-950" : "text-slate-700 hover:bg-slate-100 hover:text-slate-950",
              ]}
            >
              Escenarios
            </a>
            <a
              href="/progreso"
              aria-current={isProgress ? "page" : undefined}
              class:list={[
                "hidden rounded-lg px-3 py-2 text-sm font-semibold transition md:inline-flex",
                isProgress ? "bg-slate-100 text-slate-950" : "text-slate-700 hover:bg-slate-100 hover:text-slate-950",
              ]}
            >
              Progreso
            </a>
            <a
              href="/mapa"
              aria-current={isMap ? "page" : undefined}
              class:list={[
                "hidden rounded-lg px-3 py-2 text-sm font-semibold transition md:inline-flex",
                isMap ? "bg-slate-100 text-slate-950" : "text-slate-700 hover:bg-slate-100 hover:text-slate-950",
              ]}
            >
              Mapa
            </a>
            <a
              href="/cuenta"
              aria-current={isAccount ? "page" : undefined}
              class:list={[
                "hidden rounded-lg px-3 py-2 text-sm font-semibold transition lg:inline-flex",
                isAccount ? "bg-slate-100 text-slate-950" : "text-slate-700 hover:bg-slate-100 hover:text-slate-950",
              ]}
            >
              Mis prácticas
            </a>
            <AuthNav client:load />
          </nav>
        </div>
      </header>

      <main id="contenido-principal" tabindex="-1">
        <slot />
      </main>

      <footer class="mt-16 border-t border-slate-200 bg-white">
        <div class="mx-auto flex max-w-7xl flex-col gap-5 px-4 py-8 text-sm text-slate-600 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
          <div>
            <p class="font-semibold text-slate-900">Dale</p>
            <p>Plataforma gratuita y abierta para practicar comunicación en situaciones reales.</p>
          </div>
          <nav aria-label="Enlaces legales" class="flex flex-wrap gap-x-5 gap-y-2">
            <a href="/privacidad" class="font-medium hover:text-slate-950">Privacidad</a>
            <a href="/terminos" class="font-medium hover:text-slate-950">Términos</a>
            <a href="/cookies" class="font-medium hover:text-slate-950">Cookies</a>
          </nav>
        </div>
      </footer>
    </div>
  </body>
</html>
