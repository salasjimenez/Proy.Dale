---
import ProgressDashboard from "../components/vue/ProgressDashboard.vue";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Mi voz, mi progreso | Dale"
  description="Consulta la evolución de tus prácticas, puntajes y métricas de comunicación en Dale."
>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <div class="mb-6 rounded-2xl border border-blue-200 bg-blue-50 p-5"><h2 class="font-black text-slate-950">¿Quieres analizar tu voz con más detalle?</h2><p class="mt-2 text-sm text-slate-700">Consulta ritmo, pausas, muletillas y tendencias de tus prácticas de voz.</p><a href="/analisis-voz" class="mt-3 inline-flex min-h-11 items-center rounded-xl bg-blue-700 px-5 py-3 font-bold text-white">Abrir analítica vocal</a></div>
    <ProgressDashboard client:load />
  </section>
</BaseLayout>
