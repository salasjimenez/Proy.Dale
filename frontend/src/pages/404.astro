---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página no encontrada | Dale"
  description="La página solicitada no existe o cambió de ubicación."
>
  <section class="mx-auto flex min-h-[65vh] max-w-3xl items-center px-4 py-16 sm:px-6 lg:px-8">
    <div class="w-full rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-sm sm:p-12">
      <p class="text-sm font-black uppercase tracking-[0.18em] text-blue-700">Error 404</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">
        Esta página no está disponible
      </h1>
      <p class="mx-auto mt-5 max-w-xl leading-7 text-slate-600">
        El enlace puede haber cambiado o la dirección no existe. Puedes volver al catálogo y continuar practicando.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a
          href="/#escenarios"
          class="inline-flex min-h-12 items-center justify-center rounded-xl bg-slate-950 px-6 py-3 font-black text-white transition hover:bg-blue-700"
        >
          Ver escenarios
        </a>
        <a
          href="/"
          class="inline-flex min-h-12 items-center justify-center rounded-xl border border-slate-300 bg-white px-6 py-3 font-bold text-slate-700 transition hover:bg-slate-50"
        >
          Volver al inicio
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
