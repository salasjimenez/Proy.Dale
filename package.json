{
  "name": "dale",
  "version": "0.13.0",
  "private": true,
  "description": "Dale - plataforma abierta para practicar comunicacion en situaciones reales.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose --env-file backend/.env up -d postgres",
    "db:down": "docker compose --env-file backend/.env down",
    "db:logs": "docker compose --env-file backend/.env logs -f postgres",
    "prisma:deploy": "npm run prisma:deploy --workspace=backend",
    "prisma:status": "npm run prisma:status --workspace=backend",
    "db:seed": "npm run prisma:seed --workspace=backend",
    "ci:test": "npm run test --workspace=backend",
    "ci:build": "npm run prisma:generate --workspace=backend && npm run build",
    "check": "npm run prisma:validate --workspace=backend && npm run test --workspace=backend && npm run build"
  },
  "engines": {
    "node": ">=22 <27",
    "npm": ">=10"
  }
}
